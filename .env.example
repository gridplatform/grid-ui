# Production — copy to `.env` for `npm run build` / `npm run prod`.
# Development uses `.env.development` only (`npm run dev`).
#
# Production build REFUSES unless this file exists and VITE_GRID_API_URL is set.
# There is no override flag — use `npm run dev` on a laptop.

# Same-origin API behind Compose/nginx, or absolute URL:
VITE_GRID_API_URL=/api/v1
